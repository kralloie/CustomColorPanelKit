    "accessibilityHint.slider.focused" : {
      "comment" : "A hint for the slider of ColorComponentField while the text field is focused.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعدّل حقل النص دون تطبيق اللون. اضغط على Return في حقل النص لتطبيق التغييرات، أو على Escape لإلغاء التركيز عن الحقل والتخلّص من التغييرات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert das Textfeld, ohne die Farbe zu übernehmen. Drücken Sie im Textfeld die Eingabetaste, um die Änderungen zu übernehmen, oder die Esc-Taste, um das Textfeld zu verlassen und die Änderungen zu verwerfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjusts the text field without applying the color. Press Return in the text field to apply or Escape to unfocus the text field and discard changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica el campo de texto sin aplicar el color. Pulsa Retorno en el campo de texto para aplicar los cambios, o Escape para quitar el foco del campo y descartar los cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie le champ de texte sans appliquer la couleur. Appuyez sur Retour dans le champ de texte pour appliquer les modifications, ou sur Échap pour quitter le champ et annuler les modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica il campo di testo senza applicare il colore. Premi Invio nel campo di testo per applicare le modifiche oppure Esc per uscire dal campo e annullare le modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色には適用せず、テキストフィールドの内容を変更します。変更を適用するにはテキストフィールドでReturnキーを押し、フォーカスを外して変更を破棄するにはEscapeキーを押します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색상에 적용하지 않고 텍스트 필드의 내용을 수정합니다. 변경 사항을 적용하려면 텍스트 필드에서 Return 키를 누르고, 포커스를 해제하고 변경 사항을 취소하려면 Escape 키를 누르십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzigt het tekstveld zonder de kleur toe te passen. Druk in het tekstveld op Return om de wijzigingen toe te passen, of op Escape om het tekstveld te verlaten en de wijzigingen te verwerpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienia zawartość pola tekstowego bez stosowania koloru. Naciśnij Return w polu tekstowym, aby zastosować zmiany, lub Escape, aby opuścić pole i odrzucić zmiany."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altera o campo de texto sem aplicar a cor. Prima Return no campo de texto para aplicar as alterações, ou Escape para sair do campo e descartar as alterações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅调整文本框中的内容，不会立即应用到颜色。在文本框中按 Return 键以应用更改，或按 Escape 键以取消文本框焦点并放弃更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會調整文字欄位的內容，不會立即套用至顏色。在文字欄位中按 Return 鍵以套用更改，或按 Escape 鍵以取消文字欄位的焦點並捨棄更改。"
          }
        }
      }
    },
